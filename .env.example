# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit real values.
# ---------------------------------------------------------------------------

# --- Mesh API (REQUIRED) ----------------------------------------------------
# Every LLM and embedding call in this project goes through Mesh.
# Create a key at https://meshapi.ai — it starts with "rsk_".
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1

# Chat model. Mesh has a handful of free models (GET /v1/models -> "is_free"),
# e.g. minimax/m2-her — useful for trying the agent on a zero-balance account.
MESH_CHAT_MODEL=openai/gpt-4o

# Embedding model. NOTE: Mesh has no free embedding model, so indexing the
# catalog needs a small amount of account credit (embedding this 40-course
# catalog costs a fraction of a cent). MESH_EMBED_DIM must match the model:
#   openai/text-embedding-3-small  -> 1536   ($0.02 / 1M tokens)
#   qwen/qwen3-embedding-0.6b      -> 1024   ($0.01 / 1M tokens)
#   google/embeddinggemma-300m     ->  768   ($0.002 / 1M tokens)
# Changing the model or dimension means re-seeding: python seed.py --reset
MESH_EMBED_MODEL=openai/text-embedding-3-small
MESH_EMBED_DIM=1536

# --- App --------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=SmartReco
DEBUG=false

# --- Postgres ---------------------------------------------------------------
# Matches docker-compose. Falls back to a local SQLite file if unset.
DATABASE_URL=postgresql+psycopg://smartreco:smartreco@localhost:5432/smartreco

# Host ports docker-compose publishes on. Change these if something is already
# bound locally — a host-installed PostgreSQL on 5432 will otherwise shadow the
# container and fail authentication in a confusing way. If you change
# POSTGRES_PORT, update the port in DATABASE_URL above to match.
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333

# --- Redis (Celery broker + cache + debounce locks) -------------------------
REDIS_URL=redis://localhost:6379/0

# --- Qdrant -----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=smartreco_products

# --- Recommendation triggers (how aggressively the agent runs) -------------
RECO_SCORE_THRESHOLD=12        # weighted behaviour score needed to regenerate
RECO_COOLDOWN_SECONDS=600      # min seconds between generations for one user
RECO_MIN_EVENTS=4              # min events before the agent runs at all
RECO_BEHAVIOR_WINDOW_HOURS=72  # how far back behaviour is read
RECO_MAX_ITEMS=4               # products per recommendation

# --- Observability (bonus: LangSmith tracing) -------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smartreco
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Scheduled proactive delivery (bonus: daily email digest) ---------------
DIGEST_ENABLED=true
DIGEST_HOUR=16                 # local hour (24h) Celery Beat sends the digest
DIGEST_MINUTE=0
# Leave SMTP_HOST empty to run in dry-run mode: digests are written to
# data/digests/*.html instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SmartReco <no-reply@smartreco.local>
SMTP_STARTTLS=true
